# ---- Required ----
# Get a free key at https://build.nvidia.com  (no credit card needed)
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Optional ----
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Override model IDs if NVIDIA renames them or you prefer different models.
# Browse exact IDs at https://build.nvidia.com/models
NIM_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl
NIM_REASONING_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

DATABASE_URL=sqlite:///pet_rescue.db
